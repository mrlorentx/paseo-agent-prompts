{
  "name": "paseo-agent-system-prompt",
  "private": true,
  "version": "0.2.0",
  "description": "Manage standing instructions, role providers, and Paseo profiles through plugin settings.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "!server/*.test.ts",
    "shared/",
    "configuration/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts",
    "check-config": "node server/check-config.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.10.2",
    "@getpaseo/plugin": "0.10.2",
    "@getpaseo/protocol": "0.10.2",
    "@types/node": "^24.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/react": "~19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.3",
    "zod": "^4.4.3"
  }
}
